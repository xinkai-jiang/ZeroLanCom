{
    // Use clang-format as the default formatter for C/C++
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    // Explicit clang-format executable (optional but recommended)
    "clang-format.executable": "clang-format",
    // Fallback style if .clang-format is missing
    "clang-format.fallbackStyle": "LLVM",
    "workbench.colorCustomizations": {
        "editor.lineHighlightBackground": "#1073cf2d",
        "editor.lineHighlightBorder": "#9fced11f",
        "activityBar.background": "#0E3143",
        "titleBar.activeBackground": "#13455E",
        "titleBar.activeForeground": "#F7FBFD",
        "titleBar.inactiveBackground": "#0E3143",
        "titleBar.inactiveForeground": "#F7FBFD",
        "statusBar.background": "#0E3143",
        "statusBar.foreground": "#F7FBFD",
        "statusBar.debuggingBackground": "#0E3143",
        "statusBar.debuggingForeground": "#F7FBFD",
        "statusBar.noFolderBackground": "#0E3143",
        "statusBar.noFolderForeground": "#F7FBFD"
    }
}